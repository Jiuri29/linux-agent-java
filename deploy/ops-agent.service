[Unit]
Description=Linux AIOps Agent (Java Edition)
Documentation=https://github.com/diaofenyuan/linux-agent-java
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linux-agent
Group=linux-agent
EnvironmentFile=/etc/default/linux-aiops-agent
WorkingDirectory=/opt/linux-aiops-agent
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=60 -jar /opt/linux-aiops-agent/linux-aiops-agent.jar
Restart=on-failure
RestartSec=3
SuccessExitStatus=143

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/linux-aiops-agent /var/log/linux-aiops-agent

[Install]
WantedBy=multi-user.target
